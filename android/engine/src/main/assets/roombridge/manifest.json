{
  "manifest_version": 2,
  "name": "Room Browser Bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "roombridge@roombrowser.com"
    }
  },
  "permissions": ["nativeMessagingFromContent"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "js": ["main.js"]
    },
    {
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "run_at": "document_start",
      "all_frames": false,
      "js": ["isolated.js"]
    }
  ]
}
